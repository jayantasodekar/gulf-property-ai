# Copy to .env and fill in. NEVER commit the real .env.

# Required for AI answers. Create at https://openrouter.ai/keys
# SET THE KEY CREDIT LIMIT TO 0 so it can only ever use free models.
# Without a key the app still runs, in degraded "search mode".
OPENROUTER_API_KEY=

# Public origin of the deployment (sent to OpenRouter for attribution).
PUBLIC_URL=http://localhost:7860

# Server
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO

# Must match the model the index was built with (app/index.py records it in the
# meta table and query embedding is strict about it). all-MiniLM-L6-v2 is the
# 512MB-friendly default; paraphrase-multilingual-MiniLM-L12-v2 is better for
# Arabic but needs ~600MB resident and an index rebuild.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Abuse controls
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200
GLOBAL_DAILY_BUDGET=3000

# Comma-separated allowlist. Empty = same-origin only (recommended).
CORS_ORIGINS=
